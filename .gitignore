.DS_Store
Thumbs.db
*.log

# 依赖与构建产物
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
frontend/dist/

# 运行时数据（数据库与文件，绝不入库）
pgdata/
data/
*.db
*.db-wal
*.db-shm

# 密钥与证书（绝不入库）
.env
*.jks
*.keystore
*.p12
*.mobileprovision

# 但状态留痕文件要入库（覆盖上面的 *.log）
!docs/state/commits.log

# 运行时产物目录：只保留占位文件，内容不入库
storage/uploads/*
storage/exports/*
storage/logs/*
backups/*
!storage/**/.gitkeep
!backups/.gitkeep
.pytest-backups/
